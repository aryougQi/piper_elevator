<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Official AgileX Pika geometry adapted as a reusable xacro macro.
    center_joint is the total jaw opening in metres, matching pika_ros.
  -->
  <xacro:macro name="pika_gripper" params="parent mount_xyz:='0 0 0' mount_rpy:='0 0 0'">
    <link name="pika_gripper_base_link">
      <inertial>
        <origin xyz="0.037477 -8.1437E-07 0.0084053" rpy="0 0 0"/>
        <mass value="0.18972"/>
        <inertia
          ixx="0.0002159" ixy="3.3333E-08" ixz="-2.6278E-06"
          iyy="0.00014308" iyz="1.6782E-08" izz="0.00011036"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://pika_gripper_description/meshes/pika_gripper_base.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://pika_gripper_description/meshes/pika_gripper_base.dae"/>
        </geometry>
      </collision>
    </link>

    <joint name="pika_mount_joint" type="fixed">
      <origin xyz="${mount_xyz}" rpy="${mount_rpy}"/>
      <parent link="${parent}"/>
      <child link="pika_gripper_base_link"/>
    </joint>

    <!-- The driver's center_joint reports the total jaw opening (0..98 mm). -->
    <link name="pika_gripper_actuator_link"/>
    <joint name="center_joint" type="prismatic">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="pika_gripper_base_link"/>
      <child link="pika_gripper_actuator_link"/>
      <axis xyz="1 0 0"/>
      <limit lower="0.0" upper="0.098" effort="100" velocity="1"/>
    </joint>

    <link name="pika_gripper_left_link">
      <inertial>
        <origin xyz="0.033255 -0.014661 -0.0057614" rpy="0 0 0"/>
        <mass value="0.033674"/>
        <inertia
          ixx="1.5284E-05" ixy="1.4473E-05" ixz="1.4911E-08"
          iyy="3.448E-05" iyz="-4.3614E-09" izz="3.9744E-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="-1.57 0 1.57"/>
        <geometry>
          <mesh filename="package://pika_gripper_description/meshes/gripper_left_link.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="-1.57 0 1.57"/>
        <geometry>
          <mesh filename="package://pika_gripper_description/meshes/gripper_left_link.dae"/>
        </geometry>
      </collision>
    </link>
    <joint name="pika_left_finger_joint" type="prismatic">
      <origin xyz="0.0 0.041 0.08" rpy="1.57 0 0"/>
      <parent link="pika_gripper_base_link"/>
      <child link="pika_gripper_left_link"/>
      <axis xyz="0 0 -1"/>
      <limit lower="0.0" upper="0.049" effort="100" velocity="1"/>
      <mimic joint="center_joint" multiplier="0.5" offset="0.0"/>
    </joint>

    <link name="pika_gripper_right_link">
      <inertial>
        <origin xyz="0.033255 0.014661 -0.0058113" rpy="0 0 0"/>
        <mass value="0.033674"/>
        <inertia
          ixx="1.5284E-05" ixy="-1.4473E-05" ixz="-1.4956E-08"
          iyy="3.448E-05" iyz="-4.3614E-09" izz="3.9744E-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="1.57 0 -1.57"/>
        <geometry>
          <mesh filename="package://pika_gripper_description/meshes/gripper_right_link.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57 0 -1.57"/>
        <geometry>
          <mesh filename="package://pika_gripper_description/meshes/gripper_right_link.dae"/>
        </geometry>
      </collision>
    </link>
    <joint name="pika_right_finger_joint" type="prismatic">
      <origin xyz="0.0 -0.041 0.08" rpy="-1.57 0 0"/>
      <parent link="pika_gripper_base_link"/>
      <child link="pika_gripper_right_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.049" upper="0.0" effort="100" velocity="1"/>
      <mimic joint="center_joint" multiplier="-0.5" offset="0.0"/>
    </joint>
  </xacro:macro>
</robot>
