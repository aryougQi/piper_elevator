<?xml version="1.0" encoding="UTF-8"?>
<robot name="piper_pika">
  <group name="arm">
    <chain base_link="base_link" tip_link="tcp_link"/>
  </group>
  <group name="pika_gripper">
    <joint name="center_joint"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="0"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>
  <group_state name="open" group="pika_gripper">
    <joint name="center_joint" value="0.098"/>
  </group_state>
  <group_state name="half_open" group="pika_gripper">
    <joint name="center_joint" value="0.05"/>
  </group_state>
  <group_state name="closed" group="pika_gripper">
    <joint name="center_joint" value="0.0"/>
  </group_state>

  <end_effector
    name="pika_gripper_eef"
    parent_link="pika_gripper_base_link"
    group="pika_gripper"
    parent_group="arm"/>

  <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="link2" reason="Never"/>
  <disable_collisions link1="base_link" link2="link3" reason="Never"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link3" reason="Never"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link4" reason="Never"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link5" reason="Never"/>
  <disable_collisions link1="link3" link2="link6" reason="Never"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link6" reason="Never"/>
  <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>

  <disable_collisions link1="link6" link2="pika_gripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="link6" link2="pika_gripper_left_link" reason="Never"/>
  <disable_collisions link1="link6" link2="pika_gripper_right_link" reason="Never"/>
  <disable_collisions link1="pika_gripper_base_link" link2="pika_gripper_actuator_link" reason="Adjacent"/>
  <disable_collisions link1="pika_gripper_base_link" link2="pika_gripper_left_link" reason="Adjacent"/>
  <disable_collisions link1="pika_gripper_base_link" link2="pika_gripper_right_link" reason="Adjacent"/>
  <disable_collisions link1="pika_gripper_left_link" link2="pika_gripper_right_link" reason="Default"/>
</robot>
