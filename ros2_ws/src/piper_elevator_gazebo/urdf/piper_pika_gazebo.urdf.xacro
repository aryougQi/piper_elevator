<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper_pika">
  <xacro:arg
    name="initial_positions_file"
    default="$(find piper_elevator_gazebo)/config/gazebo_initial_positions.yaml"/>
  <xacro:arg
    name="controllers_file"
    default="$(find piper_elevator_gazebo)/config/gazebo_controllers.yaml"/>
  <xacro:arg name="tcp_offset_xyz" default="0.006 0 0.189"/>
  <xacro:arg name="tcp_offset_rpy" default="0 0 0"/>
  <xacro:arg name="camera_xyz" default="0 0 -0.10"/>
  <xacro:arg name="camera_rpy" default="0 0 0"/>

  <xacro:include filename="$(find piper_elevator_app)/config/piper_pika_description.xacro"/>
  <xacro:include filename="$(find realsense2_description)/urdf/_d405.urdf.xacro"/>

  <xacro:piper_pika_end_effector
    tcp_offset_xyz="$(arg tcp_offset_xyz)"
    tcp_offset_rpy="$(arg tcp_offset_rpy)"/>
  <xacro:sensor_d405
    parent="tcp_link"
    name="camera"
    use_nominal_extrinsics="true">
    <origin xyz="$(arg camera_xyz)" rpy="$(arg camera_rpy)"/>
  </xacro:sensor_d405>

  <xacro:property
    name="initial_positions"
    value="${xacro.load_yaml('$(arg initial_positions_file)')['initial_positions']}"/>

  <xacro:macro name="gazebo_control_joint" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial_positions[name]}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="PiperPikaGazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:gazebo_control_joint name="joint1"/>
    <xacro:gazebo_control_joint name="joint2"/>
    <xacro:gazebo_control_joint name="joint3"/>
    <xacro:gazebo_control_joint name="joint4"/>
    <xacro:gazebo_control_joint name="joint5"/>
    <xacro:gazebo_control_joint name="joint6"/>
    <xacro:gazebo_control_joint name="center_joint"/>
  </ros2_control>

  <gazebo>
    <plugin
      filename="gz_ros2_control-system"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
      <controller_manager_name>controller_manager</controller_manager_name>
    </plugin>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="piper_d405" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>/piper_d405</topic>
      <camera>
        <horizontal_fov>1.518436</horizontal_fov>
        <image>
          <width>848</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>2.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
</robot>
